<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pet Pantry - Admin Dashboard</title>
<style>
:root{--orange:#ff7a1a;--dark:#111827;--line:#e8ddd0;--light:#fffaf5;--green:#16a34a;--red:#ef4444}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,sans-serif;background:#f8f1e8;color:var(--dark)}
.login{position:fixed;inset:0;background:rgba(17,24,39,.9);z-index:999;display:flex;align-items:center;justify-content:center}
.loginbox{background:#fff;padding:30px;border-radius:20px;width:90%;max-width:360px;text-align:center;box-shadow:0 20px 50px rgba(0,0,0,.3)}
.loginbox input{width:100%;padding:13px;border:1.5px solid var(--line);border-radius:11px;margin:12px 0;outline:none}
.loginbox button{width:100%;background:var(--dark);color:#fff;border:0;padding:13px;border-radius:11px;font-weight:900;cursor:pointer}
header{background:var(--dark);color:#fff;padding:16px 20px;position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:20px}
.logo{font-weight:900;font-size:20px}.logo span{color:var(--orange)}
.stats{max-width:1300px;margin:20px auto;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;padding:0 20px}
.stat{background:#fff;border:1px solid var(--line);border-radius:18px;padding:18px}
.stat b{font-size:28px;display:block}.stat small{color:#7a6e62}
.tools{max-width:1300px;margin:0 auto;padding:0 20px 10px;display:flex;gap:10px;flex-wrap:wrap}
.tools input, .tools select{padding:11px 14px;border:1px solid var(--line);border-radius:11px;background:#fff;outline:none}
.tools button{padding:11px 16px;border-radius:11px;border:0;font-weight:800;cursor:pointer}
.btn-dark{background:var(--dark);color:#fff}.btn-orange{background:var(--orange);color:#fff}
.wrap{max-width:1300px;margin:10px auto;padding:0 20px 100px}
table{width:100%;background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;border-collapse:collapse}
th{ text-align:left;background:#fff6ec;padding:13px 12px;font-size:11px;letter-spacing:.6px;text-transform:uppercase}
td{padding:12px;border-top:1px solid #f0e6da;font-size:13px;vertical-align:top}
.badge{padding:4px 9px;border-radius:999px;font-size:11px;font-weight:800;display:inline-block}
.paid{background:#dcfce7;color:#166534}.pending{background:#fef9c3;color:#854d0e}.delivered{background:#dbeafe;color:#1e40af}
.actions{display:flex;gap:6px;flex-wrap:wrap}.actions button{padding:6px 10px;border-radius:8px;border:0;font-weight:700;cursor:pointer;font-size:11px}
.view{background:#111827;color:#fff}.done{background:var(--green);color:#fff}.del{background:#fee2e2;color:#991b1b}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:500;padding:20px;overflow:auto}
.modalbox{background:#fff;max-width:600px;margin:40px auto;border-radius:20px;overflow:hidden}
.modalhead{padding:18px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.modalbody{padding:20px;font-size:14px;line-height:1.6;white-space:pre-wrap}
@media(max-width:900px){.stats{grid-template-columns:repeat(2,1fr)} table{display:block;overflow:auto}}
</style>
</head>
<body>

<div id="login" class="login">
<div class="loginbox">
<div style="font-size:40px">🐾</div>
<h2 style="margin:10px 0">Pet Pantry Admin</h2>
<p style="font-size:13px;color:#7a6e62">Enter admin password to view orders sent to Heroesandheroiness@gmail.com</p>
<input id="pass" type="password" placeholder="Password: pet123">
<button onclick="doLogin()">Login to Dashboard</button>
<p style="font-size:11px;color:#999;margin-top:10px">Demo password: pet123 - Change in code</p>
</div>
</div>

<header><div class="logo">🐾 Pet <span>Pantry</span> Admin</div><div style="margin-left:auto;display:flex;gap:10px"><button class="btn-orange" onclick="exportCSV()" style="padding:8px 14px;border-radius:10px;border:0;font-weight:800;cursor:pointer">⬇️ Export CSV</button><button onclick="clearAll()" style="background:#fee2e2;color:#991b1b;padding:8px 14px;border-radius:10px;border:0;font-weight:800;cursor:pointer">🗑️ Clear All</button></div></header>

<div class="stats">
<div class="stat"><small>Total Orders</small><b id="sTotal">0</b><small>All time</small></div>
<div class="stat"><small>Total Revenue (USD)</small><b id="sRev">$0.00</b><small>Paid orders</small></div>
<div class="stat"><small>Pending Delivery</small><b id="sPend">0</b><small>To deliver</small></div>
<div class="stat"><small>Delivery Fees</small><b id="sDel">$0.00</b><small>Collected</small></div>
</div>

<div class="tools">
<input id="search" placeholder="🔎 Search by Order#, Name, Phone, Email..." style="flex:1;min-width:260px" oninput="render()">
<select id="filterPay" onchange="render()"><option value="All">All Payments</option><option>Credit Card</option><option>PayPal</option><option>Bank Transfer</option><option>M-Pesa / Mobile</option></select>
<select id="filterStatus" onchange="render()"><option value="All">All Status</option><option value="Paid">Paid</option><option value="Delivered">Delivered</option></select>
</div>

<div class="wrap">
<table>
<thead><tr><th>Order # / Date</th><th>Customer</th><th>Items</th><th>Payment</th><th>Total USD</th><th>Status</th><th>Action</th></tr></thead>
<tbody
